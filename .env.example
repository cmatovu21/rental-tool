# Copy this file to .env and adjust as needed.
# Matches the docker-compose.yml credentials by default.
DATABASE_URL="postgresql://rental_app:rental_app_dev_password@localhost:5432/rental_management?schema=public"

# Generate with: openssl rand -hex 32
JWT_SECRET="replace-with-a-random-64-character-hex-string"

# Used to build links in invite/reset emails (e.g. https://app.yourdomain.com)
APP_URL="http://localhost:3000"

# Optional — leave unset to use the console/dev notification providers.
# RESEND_API_KEY=""
# AFRICASTALKING_API_KEY=""
# AFRICASTALKING_USERNAME=""

# Reminder Engine (Milestone 8)
CRON_SECRET="replace-with-a-random-string-for-your-external-scheduler"
# WHATSAPP_API_KEY=""
